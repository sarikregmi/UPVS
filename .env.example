# Production Environment Variables for UPVS

# Secret key for session encryption (required)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_key_here

# Flask debug mode (set to empty or "False" in production)
DEBUG=

# Public base URL for QR verification links (required for production)
PUBLIC_BASE_URL=https://your-domain.com

# Solana RPC configuration
SOLANA_RPC_URL=https://your-rpc-provider.example.com
SOLANA_RPC_FALLBACKS=https://api.devnet.solana.com,https://rpc.ankr.com/solana

# Rate limiting storage (recommended for production)
# Options: memory (default, not recommended for prod), redis://:password@host:port
RATELIMIT_STORAGE_URL=redis://localhost:6379
